{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":configMigration",
		":pinDevDependencies",
		"abandonments:recommended",
		"mergeConfidence:all-badges"
	],
	"dependencyDashboardOSVVulnerabilitySummary": "all",
	"osvVulnerabilityAlerts": true,
	// baseline soak time; also covers update types other than
	// major/minor/patch (pin, digest, bump, replacement, ...)
	"minimumReleaseAge": "3 days",
	"minimumReleaseAgeBehaviour": "timestamp-optional",
	"prConcurrentLimit": 0,
	"prHourlyLimit": 0,
	"prCreation": "immediate",
	"semanticCommits": "enabled",
	"pre-commit": { "enabled": true },
	"addLabels": ["renovate"],
	"packageRules": [
		// cascade soak time by blast radius: the bigger the change,
		// the longer it sits before Renovate will propose it
		{
			"matchUpdateTypes": ["patch"],
			"addLabels": ["dependencies", "patch"],
			"minimumReleaseAge": "1 day"
		},
		{
			"matchUpdateTypes": ["minor"],
			"addLabels": ["dependencies", "minor"],
			"minimumReleaseAge": "2 days"
		},
		{
			"matchUpdateTypes": ["major"],
			"addLabels": ["dependencies", "major"],
			"minimumReleaseAge": "3 days"
		},
		{
			"automerge": true,
			"matchCurrentVersion": "!/^0/",
			"matchUpdateTypes": ["patch"]
		}
	],

	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/biome\\.json$/"],
			"matchStrings": [
				"\"\\$schema\":\\s*\"https://biomejs\\.dev/schemas/(?<currentValue>[^/]+)/schema\\.json\""
			],
			"depNameTemplate": "@biomejs/biome",
			"datasourceTemplate": "npm",
			// treat custom regex manager as dev dep to match automerge rule
			"depTypeTemplate": "devDependencies"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/^pyproject\\.toml$/"],
			"matchStrings": ["target-version = \"py3(?<minor>\\d+)\""],
			"currentValueTemplate": "3.{{{minor}}}",
			"autoReplaceStringTemplate": "target-version = \"py3{{{replace '.' '' newValue}}}\"",
			"depNameTemplate": "python",
			"datasourceTemplate": "python-version",
			"versioningTemplate": "python"
		}
	]
}
